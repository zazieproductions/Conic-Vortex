{
  "name": "conic-vortex",
  "private": true,
  "version": "0.2.0",
  "description": "Y̷Y̶Y̸Y̵Y̷Y̶Y̸ — a browser-based audiovisual instrument exploring procedural systems, signal processing, and hostile interface design.",
  "type": "module",
  "homepage": "https://zazie-productions.github.io/Conic-Vortex/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,css,json,md,yml,mjs,html,svg}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,json,md,yml,mjs,html,svg}\"",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run build",
    "assets:generate": "node scripts/generate-assets.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/three": "^0.185.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.5.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
